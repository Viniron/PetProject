# .gitignore для JARVIS
#
# Состав продиктован стеком из CLAUDE.md: Python + FastAPI на сервере,
# TypeScript + Next.js во фронте, PostgreSQL с ночным pg_dump, макеты
# проверяются Playwright. Правила стоят заранее, до появления папок:
# .gitignore спасает ровно тогда, когда написан ДО первого `git add`.
#
# Два инварианта проекта, которые этот файл исполняет:
#   6. Ни одного секрета в репозитории.
#   Сырые данные захвата (фото, аудио) живут 30 дней и не версионируются.


# --- Секреты ---------------------------------------------------------------
# Закрыто всё семейство .env, включая .env.production и .env.local, кроме
# заглушки .env.example — она обязана быть в репозитории (CLAUDE.md).
.env
.env.*
!.env.example

# Ключи, сертификаты, выгруженные токены. Токены ИСУ и Google OAuth хранятся
# в env и в шифрованном виде в базе, но случайный дамп сюда попасть не должен.
*.pem
*.key
*.p12
*.pfx
credentials.json
client_secret*.json
token.json
service-account*.json


# --- База данных и резервные копии -----------------------------------------
# `make backup` делает pg_dump в офсайт. Годы истории занятий не восстановить
# ничем, но и место им не в git.
*.dump
*.sql
*.sql.gz
*.sql.bz2
*.backup
backups/
# Схема меняется только через Alembic, а его миграции — .py. Значит, любой .sql
# в дереве — это выгрузка, а не исходник. Если однажды понадобится ручной SQL,
# он добавляется точечно: git add -f путь.


# --- Сырые данные захвата ---------------------------------------------------
# Фото и аудио из захвата событий удаляются через 30 дней. В историю коммитов
# они попасть не должны ни на один день.
media/
uploads/
storage/
data/raw/


# --- Python (apps/api) ------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version

# Инструменты из «Конвенций»: ruff, black, mypy, pytest
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/


# --- Node и Next.js (apps/web) ---------------------------------------------
node_modules/
.pnpm-store/
.yarn/cache/
.next/
out/
.turbo/
.swc/
*.tsbuildinfo
.eslintcache
.vercel

# Сборка — общая для обоих стеков
dist/
build/

# Сгенерированные клиенты из OpenAPI. Источник истины — packages/contracts,
# клиенты генерируются, поэтому в репозитории им делать нечего.
packages/contracts/generated/

# PWA: service worker и рабочие файлы пишет сборка next-pwa. Шаблон начинается
# с **/, иначе правило со слешем внутри привязывается к корню репозитория
# и не срабатывает в apps/web/public — проверено git check-ignore.
**/public/sw.js
**/public/workbox-*.js
**/public/worker-*.js


# --- Логи -------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*


# --- Тесты интерфейса и макеты ---------------------------------------------
# Скриншоты Playwright при визуальной проверке макетов — одноразовые,
# снимаются заново под каждую правку (design/README.md).
tmp/
.playwright-mcp/
playwright-report/
test-results/


# --- Инфраструктура ---------------------------------------------------------
# Домашний Raspberry Pi + Cloudflare Tunnel: состояние и креды туннеля
# машинные, в репозитории лежат только конфиги без секретов.
*.tfstate
*.tfstate.*
.terraform/
infra/**/secrets/
**/cloudflared/*.json


# --- Служебные файлы ОС -----------------------------------------------------
# Репозиторий лежит в OneDrive, поэтому desktop.ini появляется сам.
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*~


# --- Редакторы и инструменты ------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp

# Локальные разрешения Claude Code: содержат абсолютные пути этой машины.
.claude/settings.local.json


# --- Кэш --------------------------------------------------------------------
.cache/

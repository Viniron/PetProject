# Значения для машины разработки. Секретов здесь нет и быть не может -
# файл коммитится, и это единственная причина, по которой пароль ниже
# написан открытым текстом.
#
# Инвариант хоста 6 держится именно на этом файле: dev-база отличается от
# prod и именем (jarvis_dev против jarvis), и паролем, и портом. Перепутать
# их, промахнувшись мимо --env-file, нельзя - строка подключения не сойдётся.
#
# На Pi этот файл не используется никогда: там .env с настоящим паролем.

ENV=dev
POSTGRES_DB=jarvis_dev
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis-dev-not-a-secret

# Планировщик на машине разработки выключен: dev-стек поднимают, чтобы
# посмотреть на API, а не чтобы он ходил в настоящий ИСУ и настоящий Google.
# Для `make dev` (uvicorn мимо compose) то же самое сделано целевой
# переменной в Makefile - этот файл туда не доезжает.
SCHEDULER_ENABLED=false

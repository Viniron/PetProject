# Статика фронта и единственная дверь к API снаружи.
#
# Фронт и API обязаны жить на одном источнике (ADR-020, ADR-031 п. 3):
# тогда браузер не делает кросс-доменных запросов, а CORS не нужен вовсе -
# его нет в API намеренно. Поэтому Caddy и раздаёт файлы, и проксирует
# `/api`, а не только раздаёт.
#
# HTTP без TLS: снаружи сервис виден только через Cloudflare Tunnel, который
# и держит сертификат (ADR-017). Автоматический TLS Caddy здесь выключен -
# выписывать сертификат на внутреннее имя некому и незачем.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	# Всё предметное - на API. Порядок блоков значим: `handle` выбирает
	# первый подошедший, и статика не должна перехватывать `/api/*`.
	handle /api/* {
		reverse_proxy api:8000
	}

	# Проверка живости снаружи. Ходит мимо аутентификации по построению -
	# ручка не трогает базу и не отдаёт ничего, кроме «жив».
	handle /health {
		reverse_proxy api:8000
	}

	handle {
		# Экспорт Next кладёт каждую страницу каталогом с index.html
		# (trailingSlash), поэтому одного `{path}` мало.
		try_files {path} {path}/index.html {path}.html
		file_server
	}

	# Страница «не найдено» из сборки, но с настоящим кодом 404: через
	# try_files она отдавалась бы с кодом 200, и ошибка выглядела бы
	# как успешный ответ - в том числе для монитора.
	handle_errors {
		rewrite * /404.html
		file_server
	}

	log {
		output stdout
		format console
	}
}

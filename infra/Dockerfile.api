# Multi-arch: собирается под linux/arm64 (Pi) и linux/amd64 (машина owner, CI)
# одним и тем же файлом - инвариант хоста 4. Ничего архитектурно-специфичного
# внутрь не попадает, поэтому buildx собирает оба варианта без ветвлений:
#   docker buildx build --platform linux/amd64,linux/arm64 -f infra/Dockerfile.api .
#
# Стадий три, и порядок у них не косметический. `docker build` без `--target`
# собирает **последнюю** стадию, поэтому последней стоит `runtime` - та, что
# едет на Pi. Поставь `dev` в конец, и команда выше молча увезла бы на плату
# образ с pytest и правами root.

FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Сначала манифест, потом код: слой с зависимостями переживает правку кода.
COPY apps/api/pyproject.toml /app/apps/api/pyproject.toml
COPY apps/api/jarvis_api /app/apps/api/jarvis_api
RUN pip install /app/apps/api

# Миграции едут в образ вместе с кодом: на Pi нет venv, и `make migrate-pi`
# запускает alembic именно отсюда. Инвариант хоста 3 - схему создаёт только
# Alembic - иначе выполнить нечем.
COPY apps/api/alembic.ini /app/apps/api/alembic.ini
COPY apps/api/alembic /app/apps/api/alembic

RUN useradd --create-home --uid 10001 jarvis

# --- Прогон тестов на машине owner -----------------------------------------
#
# Существует по одной причине: на Windows этой машины Smart App Control
# блокирует неподписанную DLL из колеса `psycopg-binary`, и прогон с базой
# падает на импорте драйвера, а не на соединении - то есть не пропускается,
# а рушится. Внутри linux-образа этой политики нет, а среда та же, что
# на Pi: прогон заодно перестаёт зависеть от того, что установлено
# на рабочей машине.
#
# Стадия отдельная, чтобы `runtime` не тащил pytest и dev-зависимости.
FROM base AS dev

# Editable: код приезжает томом из рабочего дерева, и без `-e` тесты гоняли
# бы копию, вшитую в образ при сборке, - то есть показывали бы зелёное
# на правках, которых в образе нет.
RUN pip install -e "/app/apps/api[dev]"

# root, а не jarvis: editable-установка и pytest пишут в смонтированное
# дерево (.egg-info, кэш), а владелец тома со стороны Windows с uid 10001
# не совпадает. Это образ для прогона тестов, наружу он не смотрит.
WORKDIR /app/apps/api
CMD ["pytest"]

# --- То, что едет на Pi ----------------------------------------------------
#
# Последняя стадия намеренно (см. шапку файла).
FROM base AS runtime

# Приложение не пишет на диск контейнера ничего (инвариант хоста 1),
# так что root ему не нужен.
USER jarvis

EXPOSE 8000
CMD ["uvicorn", "jarvis_api.main:app", "--host", "0.0.0.0", "--port", "8000"]

# Ежемесячная проверка восстановления (Э9, SPEC §11.1).
#
# Почему отдельный юнит, а не шаг ночного бэкапа: проверка разворачивает
# дамп целиком и нагружает базу, а делать это каждую ночь незачем -
# ADR-020 требует раз в месяц. Ошибка проверки при этом не должна выглядеть
# ошибкой бэкапа: у них разные сторожа и разные причины отказа.
#
# Путь фиксирован и обязан совпадать с местом клона репозитория -
# systemd не подставляет переменные в ExecStart.

[Unit]
Description=JARVIS: проверка восстановления из свежей копии
Documentation=file:///home/jarvis/jarvis/docs/RUNBOOK.md
Requires=docker.service
After=docker.service network-online.target

# Часы у Pi без батарейки: до синхронизации по сети время берётся из
# последнего сохранённого. Проверка сравнивает возраст копии с «сейчас»,
# и на отставших часах свежий дамп выглядел бы копией из будущего.
Wants=time-sync.target
After=time-sync.target

[Service]
Type=oneshot
User=jarvis
Group=docker
WorkingDirectory=/home/jarvis/jarvis

# --apply здесь означает только ping сторожу: сама проверка живую базу
# не трогает ни в одном режиме.
ExecStart=/home/jarvis/jarvis/infra/restore-check.sh --apply

# Разворачивание дампа на карте памяти идёт дольше, чем его снятие,
# но вечно висеть не должно: заклинившая проверка не отправит ping,
# и сторож об этом скажет - ровно так и задумано.
TimeoutStartSec=3600

# Расписание проверки восстановления: раз в месяц (ADR-020, SPEC §11.1).
#
# Persistent=true - тот же принцип, что у бэкапа и что инвариант 11: если
# плата была выключена в назначенный час, проверка выполнится при следующем
# включении, а не пропустит месяц. Пропущенная проверка хуже отложенной:
# сторож ждёт сигнал раз в месяц и погаснет, а причиной окажется не бэкап,
# а выключенная в тот день плата.

[Unit]
Description=JARVIS: ежемесячная проверка восстановления

[Timer]
# Первое число месяца, через час после ночного бэкапа: проверяется копия,
# снятая этой же ночью, - и заодно та, что в этот день уезжает в месячный
# префикс B2 и переживёт все остальные.
OnCalendar=*-*-01 04:30:00
Persistent=true
RandomizedDelaySec=300
Unit=jarvis-restore-check.service

[Install]
WantedBy=timers.target

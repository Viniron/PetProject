# Расписание ночного бэкапа.
#
# Persistent=true - не косметика, а тот же принцип, что инвариант 11
# (джобы переживают перезагрузку): если Pi был выключен в 03:30, systemd
# выполнит пропущенный запуск при следующем включении, а не пропустит сутки.
# Именно этим таймер отличается от cron, который пропуск просто теряет.

[Unit]
Description=JARVIS: ночной бэкап базы, ежедневно

[Timer]
# Локальное время хоста (Europe/Moscow). Ночь выбрана не ради нагрузки -
# на Pi её нет, - а чтобы дамп ловил состояние на конец суток.
OnCalendar=*-*-* 03:30:00
Persistent=true
# Разброс до пяти минут: если однажды рядом появится второй такой таймер,
# они не начнут писать в сеть одновременно.
RandomizedDelaySec=300
Unit=jarvis-backup.service

[Install]
WantedBy=timers.target

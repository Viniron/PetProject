# Карта переменных окружения. Ни одного настоящего значения - только заглушки.
#
# Реальные значения owner вставляет сам в .env на Pi (ADR-020: панели
# переменных у хостера больше нет). Семейство .env закрыто .gitignore,
# исключение сделано ровно для этого файла.
#
# Переменные сгруппированы по этапу, на котором становятся нужны -
# порядок совпадает с таблицей "Что нужно от owner" в docs/BUILD-PROGRESS.md.

# --- Э0: скелет -------------------------------------------------------------
ENV=dev

# --- Э1: хост, база, туннель, бэкап ----------------------------------------
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=CHANGE_ME

# Внутри compose приложение собирает строку подключения из POSTGRES_*.
# Эта переменная - для запуска API и миграций вне контейнера (dev-база на
# машине owner). Инвариант хоста 6: dev и prod различаются именно ей,
# а не аккуратностью.
#
# Для базы, которую поднимает `make db-up`, значения берутся из infra/dev.env
# и подставляются прямо сюда - секретов в них нет:
#   postgresql+psycopg://jarvis:jarvis-dev-not-a-secret@127.0.0.1:5432/jarvis_dev
DATABASE_URL=postgresql+psycopg://jarvis:CHANGE_ME@localhost:5432/jarvis_dev

# Токен туннеля из панели Cloudflare: Zero Trust -> Networks -> Tunnels.
# Маршруты и публичное имя настраиваются там же, в compose только токен.
CF_TUNNEL_TOKEN=CHANGE_ME
# Сервис туннеля живёт в профиле и без этой строки не поднимается. Включать
# её нужно ровно тогда, когда токен выше заполнен настоящим значением:
# compose подставляет переменные до учёта профилей, поэтому обязательным
# токен сделать нельзя - он ронял бы и команды, туннеля не касающиеся.
COMPOSE_PROFILES=tunnel

B2_BUCKET=CHANGE_ME
B2_KEY_ID=CHANGE_ME
# Ключ только на запись: writeFiles, без deleteFiles (ADR-020). Сбойнувший
# или скомпрометированный Pi не должен уметь стереть историю копий.
B2_APP_KEY=CHANGE_ME
# Точка входа B2. Меняется только для сквозной проверки на подставной сервер;
# в рабочем окружении не трогать.
B2_API_URL=https://api.backblazeb2.com

# Ping после успешной ВЫГРУЗКИ, а не после запуска джоба (ADR-020).
# Джоб отказывается делать --apply с пустым значением: бэкап без контроля -
# это бэкап, о поломке которого узнают в день восстановления.
#
# Подходит любой сервис "мёртвой руки", принимающий GET: UptimeRobot
# (heartbeat.uptimerobot.com), Better Stack, healthchecks.io. Требование к
# нему одно и оно не про удобство: сторож должен жить ВНЕ дома, иначе он
# умрёт вместе с платой и промолчит именно тогда, когда нужен.
HEARTBEAT_URL=CHANGE_ME

# Глубина локальных копий на диске Pi. Облачный ретеншн (7 ежедневных /
# 4 недельных / 6 месячных) живёт правилами на стороне B2, а не здесь.
BACKUP_KEEP_LOCAL=7
# Префикс в бакете, на который навешены правила жизненного цикла B2, -
# то есть часть контракта с облаком, а не косметика.
BACKUP_PREFIX=daily

# --- Э3: my.itmo.ru ---------------------------------------------------------
ISU_LOGIN=CHANGE_ME
ISU_PASSWORD=CHANGE_ME
# Генерирует owner сам, хранит в двух местах. В базу не пишется и в дамп
# не попадает - иначе шифрование пароля ИСУ теряет смысл. В бакете B2
# оказаться не должен никогда.
ISU_CRED_KEY=CHANGE_ME

# --- Э4: Google Calendar ----------------------------------------------------
# JSON-ключ service account одной строкой (ADR-019: не OAuth пользователя).
GOOGLE_SA_JSON=CHANGE_ME
# Почта Google-аккаунта owner: календари создаёт сервисный аккаунт, и без
# расшаривания на эту почту owner их не увидит вовсе. Не секрет.
GOOGLE_CALENDAR_OWNER_EMAIL=CHANGE_ME

# --- Э8: модели -------------------------------------------------------------
GEMINI_API_KEY=CHANGE_ME
ANTHROPIC_API_KEY=CHANGE_ME

# Карта переменных окружения. Ни одного настоящего значения - только заглушки.
#
# Реальные значения owner вставляет сам в .env на Pi (ADR-020: панели
# переменных у хостера больше нет). Семейство .env закрыто .gitignore,
# исключение сделано ровно для этого файла.
#
# Переменные сгруппированы по этапу, на котором становятся нужны -
# порядок совпадает с таблицей "Что нужно от owner" в docs/BUILD-PROGRESS.md.

# --- Э0: скелет -------------------------------------------------------------
ENV=dev

# --- Э1: хост, база, туннель, бэкап ----------------------------------------
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=CHANGE_ME

# Внутри compose приложение собирает строку подключения из POSTGRES_*.
# Эта переменная - для запуска API и миграций вне контейнера (dev-база на
# машине owner). Инвариант хоста 6: dev и prod различаются именно ей,
# а не аккуратностью.
#
# Для базы, которую поднимает `make db-up`, значения берутся из infra/dev.env
# и подставляются прямо сюда - секретов в них нет:
#   postgresql+psycopg://jarvis:jarvis-dev-not-a-secret@127.0.0.1:5432/jarvis_dev
DATABASE_URL=postgresql+psycopg://jarvis:CHANGE_ME@localhost:5432/jarvis_dev

# Токен туннеля из панели Cloudflare: Zero Trust -> Networks -> Tunnels.
# Маршруты и публичное имя настраиваются там же, в compose только токен.
#
# Заполняется ПОСЛЕ трёх CF_ACCESS_* ниже и после зелёного `make tunnel-check-pi`
# (ADR-031 п. 3): туннель поверх сервиса без аутентификации - это публичное
# расписание. Порядок шагов - docs/RUNBOOK.md, раздел «Cloudflare».
CF_TUNNEL_TOKEN=CHANGE_ME
# Сервис туннеля живёт в профиле и без этой строки не поднимается. Включать
# её нужно ровно тогда, когда токен выше заполнен настоящим значением:
# compose подставляет переменные до учёта профилей, поэтому обязательным
# токен сделать нельзя - он ронял бы и команды, туннеля не касающиеся.
COMPOSE_PROFILES=tunnel

B2_BUCKET=CHANGE_ME
B2_KEY_ID=CHANGE_ME
# Ключ только на запись: writeFiles, без deleteFiles (ADR-020). Сбойнувший
# или скомпрометированный Pi не должен уметь стереть историю копий.
B2_APP_KEY=CHANGE_ME
# Точка входа B2. Меняется только для сквозной проверки на подставной сервер;
# в рабочем окружении не трогать.
B2_API_URL=https://api.backblazeb2.com

# Ping после успешной ВЫГРУЗКИ, а не после запуска джоба (ADR-020).
# Джоб отказывается делать --apply с пустым значением: бэкап без контроля -
# это бэкап, о поломке которого узнают в день восстановления.
#
# Подходит любой сервис "мёртвой руки", принимающий GET: UptimeRobot
# (heartbeat.uptimerobot.com), Better Stack, healthchecks.io. Требование к
# нему одно и оно не про удобство: сторож должен жить ВНЕ дома, иначе он
# умрёт вместе с платой и промолчит именно тогда, когда нужен.
HEARTBEAT_URL=CHANGE_ME

# --- Э9: живучесть (ADR-043) ------------------------------------------------
# Сторож ежедневной цепочки календаря. Сигнал уходит после прогона, в котором
# не отказал ни один шаг, - то есть монитор гаснет тогда, когда расписание
# перестало доезжать до Google. Период монитора - сутки: цепочка гоняется
# шесть раз в день, и одного удачного прогона за день достаточно.
#
# Пустое значение допустимо, в отличие от HEARTBEAT_URL: расписание в
# календаре полезно и без наблюдателя, а бэкап без контроля - нет.
JOBS_HEARTBEAT_URL=CHANGE_ME

# Сторож ежемесячной проверки восстановления. Отдельный монитор с периодом
# в месяц: общий с цепочкой означал бы, что ежедневный сигнал гасит тревогу
# о непроверенной копии.
RESTORE_HEARTBEAT_URL=CHANGE_ME

# База, в которую разворачивается дамп при проверке. Пересоздаётся каждый
# прогон; совпадение с рабочей базой джоб отвергает - имя подставляется
# в DROP DATABASE.
RESTORE_SCRATCH_DB=jarvis_restore
# Предельный возраст копии, которую проверка согласна считать свежей.
# Ночной бэкап плюс один пропущенный день: проверка прошлогоднего дампа
# сказала бы, что pg_restore работает, и промолчала бы о вставшем бэкапе.
RESTORE_MAX_DUMP_AGE_HOURS=48

# Глубина локальных копий на диске Pi. Облачный ретеншн (7 ежедневных /
# 4 недельных / 6 месячных) живёт правилами на стороне B2, а не здесь.
BACKUP_KEEP_LOCAL=7
# Префикс в бакете, на который навешены правила жизненного цикла B2, -
# то есть часть контракта с облаком, а не косметика.
BACKUP_PREFIX=daily

# --- Э3: my.itmo.ru ---------------------------------------------------------
ISU_LOGIN=CHANGE_ME
ISU_PASSWORD=CHANGE_ME
# Генерирует owner сам, хранит в двух местах. В базу не пишется и в дамп
# не попадает - иначе шифрование пароля ИСУ теряет смысл. В бакете B2
# оказаться не должен никогда.
ISU_CRED_KEY=CHANGE_ME

# --- Э4: Google Calendar ----------------------------------------------------
# JSON-ключ service account одной строкой (ADR-019: не OAuth пользователя).
GOOGLE_SA_JSON=CHANGE_ME
# Почта Google-аккаунта owner: календари создаёт сервисный аккаунт, и без
# расшаривания на эту почту owner их не увидит вовсе. Не секрет.
GOOGLE_CALENDAR_OWNER_EMAIL=CHANGE_ME

# --- Э5: планировщик --------------------------------------------------------
# Рубильник фоновых джобов. Пусто или true - планировщик работает; false -
# процесс поднимается без него (джобы тогда только руками, целями make).
SCHEDULER_ENABLED=true
# Времена прогона цепочки «забор расписания -> запись в Google» по зоне owner
# из settings.timezone, через запятую. Решение owner: каждые три часа.
SCHEDULER_DAILY_TIMES=06:30,09:30,12:30,15:30,18:30,21:30
# Пауза перед повторной попыткой догоняющего запуска. Защита от цикла
# перезапуска контейнера: без неё каждый рестарт после неудачи снова шёл бы
# в ИСУ, а за это портал банит.
SCHEDULER_CATCHUP_COOLDOWN_MINUTES=30
# Сколько слот ждёт освободившегося воркера, если предыдущий прогон затянулся.
SCHEDULER_MISFIRE_GRACE_SECONDS=1800

# --- Э6: API календаря ------------------------------------------------------
# Через сколько часов без успешного забора экран показывает полосу давности.
# Значение выведено из SCHEDULER_DAILY_TIMES: ночной перерыв девять часов
# плюс один пропущенный слот. Прореживаете расписание - поднимайте и это,
# иначе полоса появляется каждое утро и перестаёт что-либо значить.
CALENDAR_STALE_AFTER_HOURS=12
# Таймаут установки соединения с базой, секунды. Держит обещание §10:
# недоступная база даёт честный 503, а не вечный спиннер.
DB_CONNECT_TIMEOUT_SECONDS=5
# Сколько запрос ждёт свободного соединения в пуле, пока планировщик
# гоняет цепочку в том же процессе.
DB_POOL_TIMEOUT_SECONDS=10

# --- Э7: аутентификация owner (Cloudflare Access) ---------------------------
# Три переменные, без которых API отказывает на каждом /api/*. Отказ, а не
# тихий пропуск: включённый туннель поверх сервиса без аутентификации - это
# публичный доступ к расписанию и к правке периодов (ADR-031 §3, ADR-033).
#
# Порядок действий owner - docs/RUNBOOK.md, раздел «Cloudflare».
# Ни одна из трёх не секрет: домен команды и почта видны в браузере, а AUD -
# идентификатор приложения, который сам по себе ничего не открывает.
#
# Домен команды Zero Trust. Можно копировать из панели вместе с https:// -
# схема и слеш срезаются при чтении настройки.
CF_ACCESS_TEAM_DOMAIN=CHANGE_ME.cloudflareaccess.com
# Application Audience (AUD) Tag приложения из панели Cloudflare: 64 hex.
# Без сверки токен, выписанный соседнему приложению той же команды, пускал
# бы сюда.
CF_ACCESS_AUD=CHANGE_ME
# Почта owner. Политика Access - первая дверь, эта проверка - вторая:
# политику правят мышкой, и промах в ней не должен открывать расписание.
CF_ACCESS_ALLOWED_EMAIL=CHANGE_ME

# --- Э9б: второй маршрут туннеля, ssh (ADR-045) ------------------------------
# Публичное имя ssh-приложения Access вида ssh.example.ru - то же, что вписано
# в маршрут туннеля. Код за этой дверью не стоит: маршрут идёт мимо API, прямо
# на sshd платы, и проверить её можно только снаружи - походом на само имя.
# Ради этого похода строка и нужна; больше её никто не читает.
#
# Пустая строка означает «маршрута нет» и `make tunnel-check` не роняет,
# но печатает SKIP: маршрут, заведённый в панели и не вписанный сюда,
# остаётся без присмотра. Порядок - docs/RUNBOOK.md, «Второй маршрут: SSH».
CF_ACCESS_SSH_HOSTNAME=

# --- Э8: захват событий -----------------------------------------------------
# Сколько живёт черновик, к которому не вернулись. Это же число - срок,
# на который присланное owner остаётся в базе и в ночных дампах.
CAPTURE_DRAFT_TTL_HOURS=72
# Потолок текста захвата: защита базы от вставленного буфера обмена.
CAPTURE_TEXT_MAX_CHARS=4000
# Таймаут немедленной попытки записать подтверждённое событие в Google.
# Не успела - событие остаётся в очереди, дошлёт джоб (ADR-042).
CAPTURE_PUSH_TIMEOUT_SECONDS=5

# --- Ф4а: разбор книжки -----------------------------------------------------
# Окно, в котором ищется второй конец перевода между своими счетами (ADR-041):
# списание в одном банке и зачисление в другом. Решение owner - сутки. Шире -
# больше ложных пар (каждая стоит двух неверных месяцев), уже - больше
# непарных концов в очереди разбора, где их разбирает owner.
FINANCE_TRANSFER_WINDOW_DAYS=1

# --- Э12: модели ------------------------------------------------------------
# Ключи провайдеров. Заведены owner 2026-09-21; читать их начнут адаптеры
# на Э12б - до тех пор они лежат здесь, а слой моделей работает без сети.
GEMINI_API_KEY=CHANGE_ME
ANTHROPIC_API_KEY=CHANGE_ME

# Назначение «задача - модель» целиком, JSON одной строкой (§5.1). Что кому
# назначено - решение ADR-046, не кода: в исходниках нет ни одного имени
# модели, и смена назначения это правка вот этой строки.
#
# Ниже - календарь по ADR-046: разбор текста и фото одной моделью, резерв
# у второго провайдера (фолбэк внутри одного аккаунта не спасает от отказа
# аккаунта). Цены за 1M токенов оттуда же, строками: это деньги, и число
# с плавающей точкой разбор отвергает. Финансы и курсы добавляются своими
# этапами - Ф9 и дорожкой курсов.
#
# `degraded` здесь намеренно нет. Потолок расходов при тратах ~$0.10 в месяц
# (ADR-046) - предохранитель от зацикленного джоба, а не режим экономии:
# такой джоб нужно остановить, а не перевести на модель подешевле.
LLM_ROUTING={"capture_parse":{"provider":"google","model":"gemini-3.1-flash-lite","max_tokens":1024,"price_in":"0.25","price_out":"1.50","fallback":[{"provider":"anthropic","model":"claude-haiku-4-5","max_tokens":1024,"price_in":"1","price_out":"5"}]}}

# Потолок расходов на ВСЕ модели за календарный месяц, доллары (решение owner
# 2026-09-21). Достигнут - задачи с `degraded` уходят на дешёвую модель
# с записью в аудит, остальные отказывают. Тихого перерасхода нет.
LLM_MONTHLY_CAP_USD=5

# Таймаут одного вызова модели, секунды. Отдельно от HTTP_TIMEOUT_SECONDS:
# модель думает дольше, чем отвечает портал ИСУ.
LLM_TIMEOUT_SECONDS=60

# Сколько раз переспросить модель, ответившую мимо схемы. Один повтор:
# вторая неудача подряд лечится другой моделью, а не третьей попыткой.
LLM_SCHEMA_RETRIES=1

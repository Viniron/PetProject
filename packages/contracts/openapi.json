            "title": "Key",
            "type": "string"
          },
          "lesson_kind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Вид занятия: лекция, практика",
            "title": "Lesson Kind"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
